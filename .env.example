# Tenure — Environment Configuration
# Copy this to .env and fill in your values

# LLM Configuration
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.6-flash
LLM_BACKUP_MODEL=gemini-3.7-flash

# Vector DB
VECTOR_DB=chroma

# Database
DATABASE_URL=sqlite:///./db/tenure.db

# ProtoTwin
PROTOTWIN_MODEL_PATH=sim/prototwin_project/UR5e.ptm
USE_MOCK_SIM=true

# Service Ports
ANOMALY_SERVICE_PORT=8001
ALERT_SERVICE_PORT=8002
RAG_SERVICE_PORT=8003
ORCHESTRATOR_PORT=8000
